    "@vercel/analytics": "^2.0.1",
    "motion": "^12.42.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
